{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asira Router",
  "version": "0.1.0",
  "identifier": "com.asira.router",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Asira Router",
        "width": 760,
        "height": 600,
        "center": true,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "shadow": true,
        "backgroundColor": "#151515"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/asira_router_logo.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}

